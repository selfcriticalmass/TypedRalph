{
  "mode": "schema",
  "inference": {
    "backend": "openrouter",
    "model_name": "google/gemma-4-31B-it",
    "local_model_id": "google/gemma-4-31B-it",
    "local_cache_root": ".venv/huggingface",
    "download_if_missing": true,
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env_var": "OPENROUTER_API_KEY",
    "cfg_enabled": true,
    "openrouter_logprobs_supported": null,
    "context_length": 8192,
    "temperature": 0.2,
    "max_tokens": 768
  },
  "retrieval": {
    "embedding_model": "BAAI/bge-m3",
    "cache_path": "cache/vectors.parquet",
    "top_k": 5,
    "rrf_k": 60,
    "semantic_enabled": true,
    "device": "cuda:0",
    "use_fp16": false,
    "batch_size": 8,
    "max_length": 2048
  },
  "execution": {
    "workspace_root": ".",
    "artifact_dir": "artifacts",
    "free_mode_timeout": 30,
    "schema_mode_timeout": 15,
    "max_iterations": 8
  },
  "schema": {
    "registry_path": "./examples/fasta_registry.py"
  }
}
